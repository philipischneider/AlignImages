{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Release)",
      "description": "Build in-tree at build/ with Release configuration",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "OpenCV_DIR": "C:/vcpkg/installed/x64-windows/share/opencv4"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Build in-tree at build/ with Debug configuration",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "OpenCV_DIR": "C:/vcpkg/installed/x64-windows/share/opencv4"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "default",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    }
  ]
}
